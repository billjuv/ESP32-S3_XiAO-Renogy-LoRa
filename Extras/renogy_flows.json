    {
        "id": "12884949f3458fd4",
        "type": "function",
        "z": "5e98fdcc57594b7c",
        "g": "5f022ca47fdbd752",
        "name": "Wonderer Dashboard msgs",
        "func": "var line = msg.payload;\nvar fields = line.split(' ')[1].split(',');\nvar data = {};\n\nfields.forEach(function(f) {\n    var parts = f.split('=');\n    data[parts[0]] = parseFloat(parts[1]);\n});\n\nvar msgs = [\n    [{payload: data.soc}],\n    [{payload: data.batt_v}],\n    [{payload: data.batt_a}],\n    [{payload: data.solar_v}],\n    [{payload: data.solar_a}],\n    [{payload: data.solar_w}],\n    [{payload: data.ctrl_t}],\n    [{ payload: data.rssi }],\n    [{ payload: data.solar_w_max }],\n    [{ payload: data.solar_w_min }],\n    [{ payload: data.batt_v_max }],\n    [{ payload: data.batt_v_min }]\n];\nreturn msgs;",
        "outputs": 12,
