    {
        "id": "b474275dc787b1c1",
        "type": "function",
        "z": "5e98fdcc57594b7c",
        "g": "5f022ca47fdbd752",
        "name": "Parse Wonderer",
        "func": "var p = msg.payload;\n\nif (!p || typeof p !== 'object') {\n    node.warn(\"Bad payload: \" + JSON.stringify(msg.payload));\n    return null;\n}\n\nmsg.payload = \"renogy_wonderer \" +\n    \"batt_v=\" + p.batt_v + \",\" +\n    \"batt_a=\" + p.batt_a + \",\" +\n    \"soc=\" + p.soc + \",\" +\n    \"solar_v=\" + p.solar_v + \",\" +\n    \"solar_a=\" + p.solar_a + \",\" +\n    \"solar_w=\" + p.solar_w + \",\" +\n    \"batt_t=\" + p.batt_t + \",\" +\n    \"ctrl_t=\" + p.ctrl_t + \",\" +\n    \"solar_w_max=\" + p.solar_w_max + \",\" +\n    \"solar_w_min=\" + p.solar_w_min + \",\" +\n    \"batt_v_max=\" + p.batt_v_max + \",\" +\n    \"batt_v_min=\" + p.batt_v_min + \",\" +\n    \"rssi=\" + p.rssi;\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
